{
    "tagName": "div",
    "attributes": {
        "class": "card shadow-sm"
    },
    "children": [
        {
            "tagName": "div",
            "attributes": {
                "class": "table-responsive"
            },
            "children": [
                {
                    "tagName": "table",
                    "attributes": {
                        "class": "table table-hover table-striped mb-0"
                    },
                    "children": [
                        {
                            "tagName": "colgroup",
                            "jsonToSpec": {
                                "operation": "loopArray",
                                "source": "colGroup",
                                "template": {
                                    "tagName": "col",
                                    "attributes": {
                                        "style": "${style}"
                                    }
                                }
                            },
                            "children": []
                        },
                        {
                            "tagName": "thead",
                            "attributes": {
                                "class": "table-dark"
                            },
                            "children": [
                                {
                                    "tagName": "tr",
                                    "jsonToSpec": {
                                        "operation": "loopArray",
                                        "source": "columns",
                                        "template": {
                                            "tagName": "th",
                                            "textContent": "${label}"
                                        }
                                    },
                                    "children": []
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}