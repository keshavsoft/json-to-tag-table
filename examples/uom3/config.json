{
    "serial": true,
    "caption": {
        "text": "Purchase Records",
        "class": "caption-top fw-bold text-secondary ps-2 pb-1"
    },
    "colgroup": [
        {
            "key": "@_NAME",
            "width": "30%"
        },
        {
            "key": "BASEUNITS",
            "width": "70%"
        }
    ],
    "columnsConfig": [
        {
            "key": "inwardQty",
            "tbody": {
                "th": {
                    "attributes": {
                        "style": "text-align:right;",
                        "class": "iiiiiiikkk"
                    }
                }
            }
        },
        {
            "key": "outwardQty",
            "tbody": {
                "th": {
                    "attributes": {
                        "style": "text-align:right;",
                        "class": "kkkkkkkkkk"
                    }
                }
            }
        }
    ],
    "head": {
        "columns": [
            "@_NAME",
            "BASEUNITS"
        ]
    },
    "foot": [
        {
            "id": "newEntry",
            "type": "input",
            "title": "Add New",
            "values": {
                "@_NAME": {
                    "placeholder": "Enter Item Name..."
                },
                "BASEUNITS": {
                    "placeholder": "Enter Units..."
                }
            }
        },
        {
            "id": "recordCount",
            "type": "aggregate",
            "title": "Total Records",
            "values": {
                "BASEUNITS": "count"
            }
        }
    ],
    "row": {
        "striped": true,
        "hover": true
    },
    "classes": {
        "table": "table table-hover table-striped table-sm align-middle mb-0",
        "thead": "table-light",
        "th": "text-uppercase fw-semibold",
        "tbody": "",
        "tr": "",
        "td": "",
        "tfoot": "table-group-divider fw-bold"
    }
}